generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Rsvp {
  id              String           @id @default(cuid())
  fullName        String
  phoneNumber     String           @unique
  email           String?
  attending       Boolean
  whoAttending    AttendanceGroup?
  guestCount      Int              @default(0)
  expectedGuestId String?          @unique
  expectedGuest   ExpectedGuest?   @relation(fields: [expectedGuestId], references: [id], onDelete: SetNull)
  message         String?
  createdAt       DateTime         @default(now())

  @@index([createdAt])
}

model InvitingParty {
  id             String          @id @default(cuid())
  name           String          @unique
  by             String?
  maxGuestCount  Int
  expectedGuests ExpectedGuest[]
  createdAt      DateTime        @default(now())
}

model ExpectedGuest {
  id             String        @id @default(cuid())
  namePrefix     String?
  name           String
  addition       String?
  slug           String        @unique
  invitedPersons Int           @default(1)
  partyId        String
  party          InvitingParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  rsvp           Rsvp?
  createdAt      DateTime      @default(now())

  @@index([partyId])
}

enum AttendanceGroup {
  ONLY_MYSELF
  MYSELF_AND_OTHER_INVITEES
  COMPLICATED
}
